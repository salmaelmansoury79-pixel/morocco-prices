import pandas as pd

# 1) Inflation: cumulative price rise and index (2020 = 100)
infl = pd.read_csv("inflation_annual.csv")
infl["factor"] = 1 + infl["inflation_pct"] / 100
# 2020 is the base year, so we start compounding from 2021
infl["index_2020_100"] = infl["factor"].where(infl["year"] > 2020, 1).cumprod() * 100
infl["cumulative_pct"] = infl["index_2020_100"] - 100
print(infl[["year", "inflation_pct", "index_2020_100", "cumulative_pct"]].round(1))

# 2) Diesel: cost of one 50 L tank and change vs. February
fuel = pd.read_csv("fuel_diesel_2026.csv", parse_dates=["date"])
fuel["tank_50L_mad"] = (fuel["diesel_mad_per_litre"] * 50).round(0)
fuel["change_vs_feb_pct"] = (fuel["diesel_mad_per_litre"] / fuel["diesel_mad_per_litre"].iloc[0] - 1) * 100
print()
print(fuel[["date", "diesel_mad_per_litre", "tank_50L_mad", "change_vs_feb_pct"]].round(1))

# 3) Save a clean file for the dashboard
fuel.to_csv("fuel_clean.csv", index=False)
infl.to_csv("inflation_clean.csv", index=False)

# 4) Food vs non-food, 2022-2025
cat = pd.read_csv("inflation_by_category.csv")
for col in ["food_pct", "non_food_pct"]:
    cat[col.replace("_pct", "_cum_pct")] = ((1 + cat[col] / 100).cumprod() - 1) * 100
cat["gap_pts"] = cat["food_pct"] - cat["non_food_pct"]
print()
print(cat.round(1))
cat.to_csv("category_clean.csv", index=False)
